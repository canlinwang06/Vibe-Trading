#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

step() {
  printf "\n==> %s\n" "$1"
}

step "Run PR-21 JoinQuant readiness UI tests"
npm --prefix "$ROOT/frontend" run test:run -- \
  src/pages/__tests__/JoinQuantExport.test.tsx

step "Check JoinQuant readiness UI wiring and guardrails"
node - "$ROOT" <<'NODE'
const fs = require("fs");
const path = require("path");

const root = process.argv[2];
const page = fs.readFileSync(path.join(root, "frontend/src/pages/JoinQuantExport.tsx"), "utf8");
const tests = fs.readFileSync(path.join(root, "frontend/src/pages/__tests__/JoinQuantExport.test.tsx"), "utf8");
const api = fs.readFileSync(path.join(root, "frontend/src/lib/api.ts"), "utf8");

const required = [
  ["simulation readiness API is wired", api.includes("/api/joinquant/simulation-readiness")],
  ["readiness query type exists", api.includes("JoinQuantSimulationReadinessQuery")],
  ["readiness report type exists", api.includes("JoinQuantSimulationReadinessReport")],
  ["Chinese readiness panel is visible", page.includes("模拟盘准备度")],
  ["readiness action is explicit", page.includes("生成准备度报告")],
  ["readiness result panel exists", page.includes("ReadinessReportPanel")],
  ["readiness status labels are Chinese", page.includes("准备度通过") && page.includes("需要复盘")],
  ["readiness UI test coverage exists", tests.includes("generates a simulation readiness report")],
  ["invalid readiness parameter coverage exists", tests.includes("blocks invalid readiness parameters")],
];

const forbidden = [
  ["OPENAI_API_KEY must not be used", "OPENAI_API_KEY"],
  ["JoinQuant browser automation must not be added", "window.open("],
  ["JoinQuant external URL must not be hardcoded", "joinquant.com"],
  ["Playwright automation must not be added for JoinQuant", "playwright"],
  ["Selenium automation must not be added for JoinQuant", "selenium"],
];

const missing = required.filter(([, ok]) => !ok).map(([label]) => label);
const scanned = [page, api].join("\n");
const violations = forbidden
  .filter(([, token]) => scanned.includes(token))
  .map(([label]) => label);

if (missing.length || violations.length) {
  if (missing.length) console.error("missing:", missing);
  if (violations.length) console.error("violations:", violations);
  process.exit(1);
}
NODE

printf "\nPR-21 acceptance passed.\n"

#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

step() {
  printf "\n==> %s\n" "$1"
}

step "Run PR-33 JoinQuant signal-file preview UI tests"
npm --prefix "$ROOT/frontend" run test:run -- \
  src/pages/__tests__/JoinQuantExport.test.tsx \
  src/config/__tests__/ashareNavigation.test.ts \
  src/components/layout/__tests__/Layout.test.tsx \
  src/pages/__tests__/Home.test.tsx

step "Check JoinQuant signal-file preview wiring and guardrails"
node - "$ROOT" <<'NODE'
const fs = require("fs");
const path = require("path");

const root = process.argv[2];
const page = fs.readFileSync(path.join(root, "frontend/src/pages/JoinQuantExport.tsx"), "utf8");
const tests = fs.readFileSync(path.join(root, "frontend/src/pages/__tests__/JoinQuantExport.test.tsx"), "utf8");
const api = fs.readFileSync(path.join(root, "frontend/src/lib/api.ts"), "utf8");
const router = fs.readFileSync(path.join(root, "frontend/src/router.tsx"), "utf8");

const required = [
  ["router uses real JoinQuant export page", router.includes("@/pages/JoinQuantExport")],
  ["copy-package API is wired", api.includes("/api/joinquant/export/copy-package")],
  ["signal preview component exists", page.includes("SignalFilePreview")],
  ["signal file preview title exists", page.includes("信号文件预览")],
  ["signals JSON export label exists", page.includes("导出信号 JSON")],
  ["signals CSV export label exists", page.includes("导出信号 CSV")],
  ["signals JSON filename is handled", page.includes("signals.json")],
  ["signals CSV filename is handled", page.includes("signals.csv")],
  ["download JSON button exists", page.includes("下载 {file.filename}")],
  ["download helper is reused", page.includes("downloadTextFile(file.filename")],
  ["local file guardrail is visible", page.includes("本地文件")],
  ["JoinQuant account guardrail is visible", page.includes("不直接连接聚宽账户")],
  ["signal preview test coverage exists", tests.includes("信号文件预览")],
  ["signal download test coverage exists", tests.includes("downloads generated signal JSON and CSV files")],
];

const forbidden = [
  ["OPENAI_API_KEY must not be used", "OPENAI_API_KEY"],
  ["JoinQuant browser automation must not be added", "window.open("],
  ["JoinQuant external URL must not be hardcoded", "joinquant.com"],
  ["Playwright automation must not be added for JoinQuant", "playwright"],
  ["Selenium automation must not be added for JoinQuant", "selenium"],
  ["live order action must not be added", "实盘下单"],
  ["broker order action must not be added", "placeOrder"],
  ["live runner must not be added", "startLiveRunner"],
  ["live authorization must not be added", "authorizeLive"],
];

const missing = required.filter(([, ok]) => !ok).map(([label]) => label);
const joinQuantApiStart = api.indexOf("joinQuantPreflight");
const joinQuantApiEnd = api.indexOf("dailyWorkflowRun");
const joinQuantApi = joinQuantApiStart >= 0 && joinQuantApiEnd > joinQuantApiStart
  ? api.slice(joinQuantApiStart, joinQuantApiEnd)
  : "";
const scanned = [page, joinQuantApi, router].join("\n");
const violations = forbidden
  .filter(([, token]) => scanned.includes(token))
  .map(([label]) => label);

if (missing.length || violations.length) {
  if (missing.length) console.error("missing:", missing);
  if (violations.length) console.error("violations:", violations);
  process.exit(1);
}
NODE

printf "\nPR-33 acceptance passed.\n"

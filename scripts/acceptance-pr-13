#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHON_BIN="${PYTHON:-$ROOT/.venv/bin/python}"
TMP_DIR="$(mktemp -d -t vibe-pr13-portfolio-risk.XXXXXX)"

cleanup() {
  rm -rf "$TMP_DIR"
}
trap cleanup EXIT

step() {
  printf "\n==> %s\n" "$1"
}

step "Run PR-13 portfolio-risk tests"
ASHARE_DATA_ROOT="$TMP_DIR/runtime" PYTHONPATH="$ROOT/agent${PYTHONPATH:+:$PYTHONPATH}" "$PYTHON_BIN" -m pytest \
  "$ROOT/agent/tests/test_portfolio_risk.py" "$ROOT/agent/tests/test_strategy_ranking.py" -q

step "Check portfolio-risk API routes are mounted"
ASHARE_DATA_ROOT="$TMP_DIR/runtime" PYTHONPATH="$ROOT/agent${PYTHONPATH:+:$PYTHONPATH}" "$PYTHON_BIN" - <<'PY'
from __future__ import annotations

import api_server

paths = {route.path for route in api_server.app.routes}
required = {
    "/api/portfolio-risk/allocate",
    "/api/portfolio-risk/allocations",
    "/api/portfolio-risk/trade-plan",
}
missing = sorted(required - paths)
if missing:
    raise SystemExit(f"missing portfolio-risk API routes: {missing}")
PY

printf "\nPR-13 acceptance passed.\n"

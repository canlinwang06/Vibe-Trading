#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

step() {
  printf "\n==> %s\n" "$1"
}

step "Run PR-25 event reaction UI tests"
npm --prefix "$ROOT/frontend" run test:run -- \
  src/pages/__tests__/EventReactions.test.tsx \
  src/config/__tests__/ashareNavigation.test.ts \
  src/components/layout/__tests__/Layout.test.tsx \
  src/pages/__tests__/Home.test.tsx

step "Check event reaction UI wiring and guardrails"
node - "$ROOT" <<'NODE'
const fs = require("fs");
const path = require("path");

const root = process.argv[2];
const page = fs.readFileSync(path.join(root, "frontend/src/pages/EventReactions.tsx"), "utf8");
const tests = fs.readFileSync(path.join(root, "frontend/src/pages/__tests__/EventReactions.test.tsx"), "utf8");
const api = fs.readFileSync(path.join(root, "frontend/src/lib/api.ts"), "utf8");
const router = fs.readFileSync(path.join(root, "frontend/src/router.tsx"), "utf8");
const nav = fs.readFileSync(path.join(root, "frontend/src/config/ashareNavigation.ts"), "utf8");

const required = [
  ["calculate API is wired", api.includes("/api/event-reactions/calculate")],
  ["list API is wired", api.includes("/api/event-reactions")],
  ["summary API is wired", api.includes("/api/event-reactions/summary")],
  ["typed reaction record exists", api.includes("EventReactionRecord")],
  ["route is registered", router.includes("/event-reactions")],
  ["sidebar navigation exists", nav.includes("事件反应")],
  ["Chinese page title exists", page.includes("事件反应研究")],
  ["calculate action exists", page.includes("计算事件反应")],
  ["summary action exists", page.includes("生成摘要")],
  ["detail action exists", page.includes("刷新明细")],
  ["default AI subtype exists", page.includes("AI算力")],
  ["summary test exists", tests.includes("renders summary and reaction details")],
];

const forbidden = [
  ["OPENAI_API_KEY must not be used", "OPENAI_API_KEY"],
  ["JoinQuant browser automation must not be added", "window.open("],
  ["JoinQuant external URL must not be hardcoded", "joinquant.com"],
  ["Playwright automation must not be added", "playwright"],
  ["Selenium automation must not be added", "selenium"],
  ["workflow UI must not call approval", "approvePlan"],
  ["workflow UI must not call live runner", "startLiveRunner"],
  ["workflow UI must not call live authorization", "authorizeLive"],
];

const missing = required.filter(([, ok]) => !ok).map(([label]) => label);
const eventApiStart = api.indexOf("eventReactionsCalculate");
const eventApiEnd = api.indexOf("// Alpha Zoo API");
const eventApi = eventApiStart >= 0 && eventApiEnd > eventApiStart
  ? api.slice(eventApiStart, eventApiEnd)
  : "";
const scanned = [page, eventApi].join("\n");
const violations = forbidden
  .filter(([, token]) => scanned.includes(token))
  .map(([label]) => label);

if (missing.length || violations.length) {
  if (missing.length) console.error("missing:", missing);
  if (violations.length) console.error("violations:", violations);
  process.exit(1);
}
NODE

printf "\nPR-25 acceptance passed.\n"

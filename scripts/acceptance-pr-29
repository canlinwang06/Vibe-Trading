#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

step() {
  printf "\n==> %s\n" "$1"
}

step "Run PR-29 backtest-results UI tests"
npm --prefix "$ROOT/frontend" run test:run -- \
  src/pages/__tests__/BacktestResults.test.tsx \
  src/config/__tests__/ashareNavigation.test.ts \
  src/components/layout/__tests__/Layout.test.tsx \
  src/pages/__tests__/Home.test.tsx

step "Check backtest-results UI wiring and guardrails"
node - "$ROOT" <<'NODE'
const fs = require("fs");
const path = require("path");

const root = process.argv[2];
const page = fs.readFileSync(path.join(root, "frontend/src/pages/BacktestResults.tsx"), "utf8");
const tests = fs.readFileSync(path.join(root, "frontend/src/pages/__tests__/BacktestResults.test.tsx"), "utf8");
const api = fs.readFileSync(path.join(root, "frontend/src/lib/api.ts"), "utf8");
const router = fs.readFileSync(path.join(root, "frontend/src/router.tsx"), "utf8");
const nav = fs.readFileSync(path.join(root, "frontend/src/config/ashareNavigation.ts"), "utf8");

const required = [
  ["backtest list API is wired", api.includes("/api/strategy-lab/backtest-runs")],
  ["ranking API is wired", api.includes("/api/strategy-lab/backtest-rankings")],
  ["typed backtest run exists", api.includes("BacktestRun")],
  ["typed ranking response exists", api.includes("BacktestRankingResponse")],
  ["route uses real page", router.includes("@/pages/BacktestResults")],
  ["route is registered", router.includes("/backtest-results")],
  ["sidebar navigation exists", nav.includes("回测结果")],
  ["Chinese page title exists", page.includes("回测结果")],
  ["refresh runs action exists", page.includes("刷新回测结果")],
  ["refresh rankings action exists", page.includes("刷新策略排名")],
  ["guardrail copy exists", page.includes("只读验收页")],
  ["run API test exists", tests.includes("loads backtest runs")],
  ["ranking API test exists", tests.includes("loads strategy rankings")],
];

const forbidden = [
  ["OPENAI_API_KEY must not be used", "OPENAI_API_KEY"],
  ["JoinQuant browser automation must not be added", "window.open("],
  ["JoinQuant external URL must not be hardcoded", "joinquant.com"],
  ["Playwright automation must not be added", "playwright"],
  ["Selenium automation must not be added", "selenium"],
  ["backtest UI must not call approval", "approvePlan"],
  ["backtest UI must not call broker action", "placeOrder"],
  ["backtest UI must not call live runner", "startLiveRunner"],
  ["backtest UI must not call live authorization", "authorizeLive"],
];

const missing = required.filter(([, ok]) => !ok).map(([label]) => label);
const strategyApiStart = api.indexOf("listStrategyBacktestRuns");
const strategyApiEnd = api.indexOf("listCandidatePool");
const strategyApi = strategyApiStart >= 0 && strategyApiEnd > strategyApiStart
  ? api.slice(strategyApiStart, strategyApiEnd)
  : "";
const scanned = [page, strategyApi].join("\n");
const violations = forbidden
  .filter(([, token]) => scanned.includes(token))
  .map(([label]) => label);

if (missing.length || violations.length) {
  if (missing.length) console.error("missing:", missing);
  if (violations.length) console.error("violations:", violations);
  process.exit(1);
}
NODE

printf "\nPR-29 acceptance passed.\n"

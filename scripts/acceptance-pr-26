#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

step() {
  printf "\n==> %s\n" "$1"
}

step "Run PR-26 daily workflow event reaction tests"
"$ROOT/.venv/bin/python" -m pytest \
  "$ROOT/agent/tests/test_daily_workflow.py" \
  "$ROOT/agent/tests/test_event_reactions.py" \
  -q

step "Run PR-26 daily workflow UI tests"
npm --prefix "$ROOT/frontend" run test:run -- \
  src/pages/__tests__/DailyWorkflow.test.tsx

step "Check workflow event reaction wiring and guardrails"
python3 - "$ROOT" <<'PY'
from __future__ import annotations

import pathlib
import sys

root = pathlib.Path(sys.argv[1])
service = (root / "agent/src/daily_workflow/service.py").read_text(encoding="utf-8")
routes = (root / "agent/src/api/daily_workflow_routes.py").read_text(encoding="utf-8")
page = (root / "frontend/src/pages/DailyWorkflow.tsx").read_text(encoding="utf-8")
api = (root / "frontend/src/lib/api.ts").read_text(encoding="utf-8")
tests = (root / "agent/tests/test_daily_workflow.py").read_text(encoding="utf-8")

required = [
    ("workflow step exists", '"calculate_event_reactions"' in service),
    ("event reaction service is called", "EventReactionService" in service),
    ("event reaction errors are caught", "EventReactionError" in service),
    ("route exposes windows", "event_reaction_windows" in routes),
    ("route exposes target types", "event_reaction_target_types" in routes),
    ("frontend step label exists", "事件反应" in page),
    ("frontend request sends windows", "event_reaction_windows" in page),
    ("frontend API contract includes event reaction fields", "event_reaction_windows" in api),
    ("backend test asserts reaction write", "event_reactions" in tests),
    ("research guardrail is returned", '"research_only": True' in service),
    ("live trading is disabled", '"live_trading": False' in service),
]
forbidden = [
    ("OPENAI_API_KEY must not be used", "OPENAI_API_KEY"),
    ("browser automation must not be added", "playwright"),
    ("Selenium automation must not be added", "selenium"),
    ("JoinQuant remote URL must not be added", "joinquant.com"),
    ("approval must not be called", "approve_plan("),
    ("broker action must not be added", "place_order"),
]

missing = [label for label, ok in required if not ok]
scanned = "\n".join([service, routes, page])
violations = [label for label, token in forbidden if token in scanned]

if missing or violations:
    if missing:
        print("missing:", missing, file=sys.stderr)
    if violations:
        print("violations:", violations, file=sys.stderr)
    raise SystemExit(1)
PY

printf "\nPR-26 acceptance passed.\n"

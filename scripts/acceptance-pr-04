#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHON_BIN="${PYTHON:-$ROOT/.venv/bin/python}"
TMP_DIR="$(mktemp -d -t vibe-pr04-ashare-market.XXXXXX)"

cleanup() {
  rm -rf "$TMP_DIR"
}
trap cleanup EXIT

step() {
  printf "\n==> %s\n" "$1"
}

fail() {
  printf "PR-04 acceptance failed: %s\n" "$1" >&2
  exit 1
}

step "Run PR-04 asset and market-data tests"
ASHARE_DATA_ROOT="$TMP_DIR/runtime" PYTHONPATH="$ROOT/agent${PYTHONPATH:+:$PYTHONPATH}" "$PYTHON_BIN" -m pytest \
  "$ROOT/agent/tests/test_ashare_market_data.py" -q

step "Check manual update API route is mounted"
ASHARE_DATA_ROOT="$TMP_DIR/runtime" PYTHONPATH="$ROOT/agent${PYTHONPATH:+:$PYTHONPATH}" "$PYTHON_BIN" - <<'PY'
from __future__ import annotations

import api_server

paths = {route.path for route in api_server.app.routes}
required = {
    "/ashare/assets/{ticker}",
    "/ashare/market-daily",
    "/ashare/market-data/update",
}
missing = sorted(required - paths)
if missing:
    raise SystemExit(f"missing A-share API routes: {missing}")
PY

printf "\nPR-04 acceptance passed.\n"

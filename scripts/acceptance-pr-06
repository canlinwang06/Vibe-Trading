#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHON_BIN="${PYTHON:-$ROOT/.venv/bin/python}"
TMP_DIR="$(mktemp -d -t vibe-pr06-event-extract.XXXXXX)"

cleanup() {
  rm -rf "$TMP_DIR"
}
trap cleanup EXIT

step() {
  printf "\n==> %s\n" "$1"
}

fail() {
  printf "PR-06 acceptance failed: %s\n" "$1" >&2
  exit 1
}

step "Run PR-06 event extraction tests"
ASHARE_DATA_ROOT="$TMP_DIR/runtime" PYTHONPATH="$ROOT/agent${PYTHONPATH:+:$PYTHONPATH}" "$PYTHON_BIN" -m pytest \
  "$ROOT/agent/tests/test_event_extraction.py" -q

step "Check event radar extraction/query API routes are mounted"
ASHARE_DATA_ROOT="$TMP_DIR/runtime" PYTHONPATH="$ROOT/agent${PYTHONPATH:+:$PYTHONPATH}" "$PYTHON_BIN" - <<'PY'
from __future__ import annotations

import api_server

paths = {route.path for route in api_server.app.routes}
required = {
    "/api/event-radar/events",
    "/api/event-radar/clusters",
    "/api/event-radar/clusters/{cluster_id}",
    "/api/event-radar/extract/run",
}
missing = sorted(required - paths)
if missing:
    raise SystemExit(f"missing event extraction API routes: {missing}")
PY

printf "\nPR-06 acceptance passed.\n"

#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

step() {
  printf "\n==> %s\n" "$1"
}

step "Run PR-19 JoinQuant execution-report UI tests"
npm --prefix "$ROOT/frontend" run test:run -- \
  src/pages/__tests__/JoinQuantExport.test.tsx

step "Check JoinQuant execution-report UI wiring and guardrails"
node - "$ROOT" <<'NODE'
const fs = require("fs");
const path = require("path");

const root = process.argv[2];
const page = fs.readFileSync(path.join(root, "frontend/src/pages/JoinQuantExport.tsx"), "utf8");
const tests = fs.readFileSync(path.join(root, "frontend/src/pages/__tests__/JoinQuantExport.test.tsx"), "utf8");
const api = fs.readFileSync(path.join(root, "frontend/src/lib/api.ts"), "utf8");

const required = [
  ["execution report import API is wired", api.includes("/api/joinquant/execution-reports/import")],
  ["execution report list API is wired", api.includes("/api/joinquant/execution-reports")],
  ["execution report summary API is wired", api.includes("/api/joinquant/execution-reports/summary")],
  ["Chinese import panel is visible", page.includes("执行报告导入")],
  ["JSON paste field is visible", page.includes("报告 JSON")],
  ["import action is explicit", page.includes("导入报告")],
  ["summary action is explicit", page.includes("查询复盘")],
  ["local JSON parser validates pasted rows", page.includes("parseReportRows")],
  ["import test coverage exists", tests.includes("imports pasted JoinQuant execution reports")],
  ["invalid JSON test coverage exists", tests.includes("blocks invalid execution report JSON")],
  ["summary refresh test coverage exists", tests.includes("refreshes execution summary")],
];

const forbidden = [
  ["OPENAI_API_KEY must not be used", "OPENAI_API_KEY"],
  ["JoinQuant browser automation must not be added", "window.open("],
  ["JoinQuant external URL must not be hardcoded", "joinquant.com"],
  ["Playwright automation must not be added for JoinQuant", "playwright"],
  ["Selenium automation must not be added for JoinQuant", "selenium"],
];

const missing = required.filter(([, ok]) => !ok).map(([label]) => label);
const scanned = [page, api].join("\n");
const violations = forbidden
  .filter(([, token]) => scanned.includes(token))
  .map(([label]) => label);

if (missing.length || violations.length) {
  if (missing.length) console.error("missing:", missing);
  if (violations.length) console.error("violations:", violations);
  process.exit(1);
}
NODE

printf "\nPR-19 acceptance passed.\n"

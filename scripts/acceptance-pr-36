#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHON_BIN="${PYTHON:-$ROOT/.venv/bin/python}"
WITH_SERVER="/Users/colin/.agents/skills/webapp-testing/scripts/with_server.py"
BACKEND_PORT="${VIBE_PR36_BACKEND_PORT:-18999}"
FRONTEND_PORT="${VIBE_PR36_FRONTEND_PORT:-15899}"
QA_ROOT="$(mktemp -d -t vibe-pr36-qa.XXXXXX)"

cleanup() {
  rm -rf "$QA_ROOT"
}
trap cleanup EXIT

step() {
  printf "\n==> %s\n" "$1"
}

fail() {
  printf "PR-36 acceptance failed: %s\n" "$1" >&2
  exit 1
}

step "Check PR-36 browser QA prerequisites"
[[ -x "$PYTHON_BIN" ]] || fail "missing Python virtualenv: $PYTHON_BIN"
[[ -f "$WITH_SERVER" ]] || fail "missing webapp-testing server helper: $WITH_SERVER"
[[ -f "$ROOT/frontend/package.json" ]] || fail "missing frontend package.json"

export ASHARE_DATA_ROOT="$QA_ROOT/ashare"
export LANGCHAIN_PROVIDER="openai-codex"
export OPENAI_CODEX_BASE_URL="https://chatgpt.com/backend-api/codex/responses"
export VIBE_PR36_BACKEND_URL="http://127.0.0.1:$BACKEND_PORT"
export VIBE_PR36_FRONTEND_URL="http://127.0.0.1:$FRONTEND_PORT"
export VIBE_PR36_WORKFLOW_DATE="2026-06-24"

step "Run browser-based full functional flow"
"$PYTHON_BIN" "$WITH_SERVER" \
  --server "cd $ROOT && env ASHARE_DATA_ROOT=$ASHARE_DATA_ROOT LANGCHAIN_PROVIDER=$LANGCHAIN_PROVIDER OPENAI_CODEX_BASE_URL=$OPENAI_CODEX_BASE_URL PYTHONPATH=$ROOT/agent $PYTHON_BIN -c 'import cli, sys; raise SystemExit(cli.main(sys.argv[1:]))' serve --host 127.0.0.1 --port $BACKEND_PORT" \
  --port "$BACKEND_PORT" \
  --server "cd $ROOT/frontend && env VITE_API_URL=http://127.0.0.1:$BACKEND_PORT npm run dev -- --host 127.0.0.1 --port $FRONTEND_PORT" \
  --port "$FRONTEND_PORT" \
  --timeout 90 \
  -- "$PYTHON_BIN" "$ROOT/scripts/pr36_browser_full_flow.py"

step "Check PR-36 automation scope and guardrails"
node - "$ROOT" <<'NODE'
const fs = require("fs");
const path = require("path");

const root = process.argv[2];
const qa = fs.readFileSync(path.join(root, "scripts/pr36_browser_full_flow.py"), "utf8");
const acceptance = fs.readFileSync(path.join(root, "scripts/acceptance-pr-36"), "utf8");

const required = [
  ["browser script seeds AI industry-chain fixture", qa.includes("AI 产业链事件跟踪")],
  ["browser script opens daily workflow", qa.includes("/daily-workflow")],
  ["browser script runs local workflow", qa.includes("运行工作流")],
  ["browser script checks local backtests", qa.includes("已写入 8 个本地回测结果")],
  ["browser script performs simulation approval", qa.includes("/api/portfolio-risk/approve-plan")],
  ["browser script opens JoinQuant export UI", qa.includes("/joinquant-export")],
  ["browser script generates copy package", qa.includes("生成复制包")],
  ["browser script verifies package files", qa.includes("strategy.py") && qa.includes("signals.json") && qa.includes("signals.csv")],
  ["acceptance uses isolated A-share data root", acceptance.includes("mktemp") && acceptance.includes("ASHARE_DATA_ROOT")],
  ["acceptance uses browser helper", acceptance.includes("with_server.py")],
];

const forbidden = [
  ["model API key must not be introduced", "OPENAI_API_KEY"],
  ["external JoinQuant browser launch must not be added", "window.open("],
  ["external JoinQuant URL must not be hardcoded", "joinquant.com"],
  ["live order action must not be added", "placeOrder"],
  ["live runner start must not be added", "startLiveRunner"],
  ["live authorization must not be added", "authorizeLive"],
  ["live trading copy must not be added", "实盘下单"],
];

const scanned = qa;
const missing = required.filter(([, ok]) => !ok).map(([label]) => label);
const violations = forbidden
  .filter(([, token]) => scanned.includes(token))
  .map(([label]) => label);

if (missing.length || violations.length) {
  if (missing.length) console.error("missing:", missing);
  if (violations.length) console.error("violations:", violations);
  process.exit(1);
}
NODE

printf "\nPR-36 acceptance passed.\n"

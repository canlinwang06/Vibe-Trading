#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

step() {
  printf "\n==> %s\n" "$1"
}

step "Run PR-30 risk-portfolio UI tests"
npm --prefix "$ROOT/frontend" run test:run -- \
  src/pages/__tests__/RiskPortfolio.test.tsx \
  src/config/__tests__/ashareNavigation.test.ts \
  src/components/layout/__tests__/Layout.test.tsx \
  src/pages/__tests__/Home.test.tsx

step "Check risk-portfolio UI wiring and guardrails"
node - "$ROOT" <<'NODE'
const fs = require("fs");
const path = require("path");

const root = process.argv[2];
const page = fs.readFileSync(path.join(root, "frontend/src/pages/RiskPortfolio.tsx"), "utf8");
const tests = fs.readFileSync(path.join(root, "frontend/src/pages/__tests__/RiskPortfolio.test.tsx"), "utf8");
const api = fs.readFileSync(path.join(root, "frontend/src/lib/api.ts"), "utf8");
const router = fs.readFileSync(path.join(root, "frontend/src/router.tsx"), "utf8");
const nav = fs.readFileSync(path.join(root, "frontend/src/config/ashareNavigation.ts"), "utf8");

const required = [
  ["portfolio allocation API is wired", api.includes("/api/portfolio-risk/allocate")],
  ["allocation list API is wired", api.includes("/api/portfolio-risk/allocations")],
  ["trade-plan API is wired", api.includes("/api/portfolio-risk/trade-plan")],
  ["typed allocation response exists", api.includes("PortfolioAllocationResponse")],
  ["typed trade-plan response exists", api.includes("PortfolioTradePlanResponse")],
  ["route uses real page", router.includes("@/pages/RiskPortfolio")],
  ["route is registered", router.includes("/risk-portfolio")],
  ["sidebar navigation exists", nav.includes("风控组合")],
  ["Chinese page title exists", page.includes("风控组合")],
  ["allocation action exists", page.includes("运行组合风控")],
  ["refresh allocations action exists", page.includes("刷新策略分配")],
  ["draft trade-plan action exists", page.includes("生成交易计划草案")],
  ["research guardrail copy exists", page.includes("不审批 / 不下单")],
  ["allocation API test exists", tests.includes("allocates strategy capital through the API")],
  ["trade-plan draft test exists", tests.includes("loads a draft trade plan without approving it")],
];

const forbidden = [
  ["OPENAI_API_KEY must not be used", "OPENAI_API_KEY"],
  ["JoinQuant browser automation must not be added", "window.open("],
  ["JoinQuant external URL must not be hardcoded", "joinquant.com"],
  ["Playwright automation must not be added", "playwright"],
  ["Selenium automation must not be added", "selenium"],
  ["risk UI must not call approval", "approvePlan"],
  ["risk UI must not call approve-plan route", "approve-plan"],
  ["risk UI must not generate draft signals", "generateDraftSignals"],
  ["risk UI must not call generate-signals route", "generate-signals"],
  ["risk UI must not call broker action", "placeOrder"],
  ["risk UI must not call live runner", "startLiveRunner"],
  ["risk UI must not call live authorization", "authorizeLive"],
];

const missing = required.filter(([, ok]) => !ok).map(([label]) => label);
const riskApiStart = api.indexOf("allocateRiskPortfolio");
const riskApiEnd = api.indexOf("listCandidatePool");
const riskApi = riskApiStart >= 0 && riskApiEnd > riskApiStart
  ? api.slice(riskApiStart, riskApiEnd)
  : "";
const scanned = [page, riskApi].join("\n");
const violations = forbidden
  .filter(([, token]) => scanned.includes(token))
  .map(([label]) => label);

if (missing.length || violations.length) {
  if (missing.length) console.error("missing:", missing);
  if (violations.length) console.error("violations:", violations);
  process.exit(1);
}
NODE

printf "\nPR-30 acceptance passed.\n"

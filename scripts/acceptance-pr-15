#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHON_BIN="${PYTHON:-$ROOT/.venv/bin/python}"
TMP_DIR="$(mktemp -d -t vibe-pr15-joinquant-export.XXXXXX)"

cleanup() {
  rm -rf "$TMP_DIR"
}
trap cleanup EXIT

step() {
  printf "\n==> %s\n" "$1"
}

step "Run PR-15 JoinQuant mapping and export tests"
ASHARE_DATA_ROOT="$TMP_DIR/runtime" PYTHONPATH="$ROOT/agent${PYTHONPATH:+:$PYTHONPATH}" "$PYTHON_BIN" -m pytest \
  "$ROOT/agent/tests/test_joinquant_adapter.py" "$ROOT/agent/tests/test_portfolio_risk.py" -q

step "Check JoinQuant export API routes are mounted"
ASHARE_DATA_ROOT="$TMP_DIR/runtime" PYTHONPATH="$ROOT/agent${PYTHONPATH:+:$PYTHONPATH}" "$PYTHON_BIN" - <<'PY'
from __future__ import annotations

import api_server

paths = {route.path for route in api_server.app.routes}
required = {
    "/api/joinquant/export/preflight",
    "/api/joinquant/export/signals-json",
    "/api/joinquant/export/signals-csv",
}
missing = sorted(required - paths)
if missing:
    raise SystemExit(f"missing JoinQuant export API routes: {missing}")
PY

printf "\nPR-15 acceptance passed.\n"

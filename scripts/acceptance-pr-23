#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

step() {
  printf "\n==> %s\n" "$1"
}

step "Run PR-23 daily workflow UI tests"
npm --prefix "$ROOT/frontend" run test:run -- \
  src/pages/__tests__/DailyWorkflow.test.tsx \
  src/config/__tests__/ashareNavigation.test.ts \
  src/components/layout/__tests__/Layout.test.tsx \
  src/pages/__tests__/Home.test.tsx

step "Check daily workflow UI wiring and guardrails"
node - "$ROOT" <<'NODE'
const fs = require("fs");
const path = require("path");

const root = process.argv[2];
const page = fs.readFileSync(path.join(root, "frontend/src/pages/DailyWorkflow.tsx"), "utf8");
const tests = fs.readFileSync(path.join(root, "frontend/src/pages/__tests__/DailyWorkflow.test.tsx"), "utf8");
const api = fs.readFileSync(path.join(root, "frontend/src/lib/api.ts"), "utf8");
const router = fs.readFileSync(path.join(root, "frontend/src/router.tsx"), "utf8");
const nav = fs.readFileSync(path.join(root, "frontend/src/config/ashareNavigation.ts"), "utf8");

const required = [
  ["daily workflow API is wired", api.includes("/api/daily-workflow/run")],
  ["typed request contract exists", api.includes("DailyWorkflowRunRequest")],
  ["typed response contract exists", api.includes("DailyWorkflowRunResponse")],
  ["route is registered", router.includes("/daily-workflow")],
  ["sidebar navigation exists", nav.includes("每日工作流")],
  ["Chinese page title exists", page.includes("每日研究工作流")],
  ["AI industry-chain default task exists", page.includes("AI 产业链事件跟踪")],
  ["manual run action exists", page.includes("运行工作流")],
  ["dry-run action exists", page.includes("试运行")],
  ["guardrail copy is visible", page.includes("不审批 / 不导出 / 不实盘")],
  ["blocked feedback test exists", tests.includes("renders blocked-step feedback")],
  ["no-step validation test exists", tests.includes("no workflow step is selected")],
];

const forbidden = [
  ["OPENAI_API_KEY must not be used", "OPENAI_API_KEY"],
  ["JoinQuant browser automation must not be added", "window.open("],
  ["JoinQuant external URL must not be hardcoded", "joinquant.com"],
  ["Playwright automation must not be added", "playwright"],
  ["Selenium automation must not be added", "selenium"],
  ["workflow UI must not call approval", "approvePlan"],
  ["workflow UI must not call live runner", "startLiveRunner"],
  ["workflow UI must not call live authorization", "authorizeLive"],
];

const missing = required.filter(([, ok]) => !ok).map(([label]) => label);
const workflowApiStart = api.indexOf("dailyWorkflowRun");
const workflowApiEnd = api.indexOf("// Alpha Zoo API");
const workflowApi = workflowApiStart >= 0 && workflowApiEnd > workflowApiStart
  ? api.slice(workflowApiStart, workflowApiEnd)
  : "";
const scanned = [page, workflowApi].join("\n");
const violations = forbidden
  .filter(([, token]) => scanned.includes(token))
  .map(([label]) => label);

if (missing.length || violations.length) {
  if (missing.length) console.error("missing:", missing);
  if (violations.length) console.error("violations:", violations);
  process.exit(1);
}
NODE

printf "\nPR-23 acceptance passed.\n"

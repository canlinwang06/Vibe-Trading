#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHON_BIN="${PYTHON:-$ROOT/.venv/bin/python}"
WITH_SERVER="/Users/colin/.agents/skills/webapp-testing/scripts/with_server.py"
BACKEND_PORT="${VIBE_PR37_BACKEND_PORT:-19999}"
FRONTEND_PORT="${VIBE_PR37_FRONTEND_PORT:-15937}"
QA_ROOT="$(mktemp -d -t vibe-pr37-qa.XXXXXX)"

cleanup() {
  rm -rf "$QA_ROOT"
}
trap cleanup EXIT

step() {
  printf "\n==> %s\n" "$1"
}

fail() {
  printf "PR-37 acceptance failed: %s\n" "$1" >&2
  exit 1
}

step "Run PR-37 radar page tests"
npm --prefix "$ROOT/frontend" run test:run -- \
  src/pages/__tests__/EventRadar.test.tsx \
  src/pages/__tests__/SectorRadar.test.tsx \
  src/pages/__tests__/Home.test.tsx \
  src/config/__tests__/ashareNavigation.test.ts \
  src/components/layout/__tests__/Layout.test.tsx

step "Run browser QA for event and sector radar"
[[ -x "$PYTHON_BIN" ]] || fail "missing Python virtualenv: $PYTHON_BIN"
[[ -f "$WITH_SERVER" ]] || fail "missing webapp-testing server helper: $WITH_SERVER"

export ASHARE_DATA_ROOT="$QA_ROOT/ashare"
export LANGCHAIN_PROVIDER="openai-codex"
export OPENAI_CODEX_BASE_URL="https://chatgpt.com/backend-api/codex/responses"
export VIBE_PR37_BACKEND_URL="http://127.0.0.1:$BACKEND_PORT"
export VIBE_PR37_FRONTEND_URL="http://127.0.0.1:$FRONTEND_PORT"
export VIBE_PR37_RADAR_DATE="2026-06-19"
export VIBE_PR37_SCORE_DATE="2026-06-24"
export VIBE_PR37_SKIP_SCRIPT_SEED="1"

PYTHONPATH="$ROOT/agent" "$PYTHON_BIN" -c "import sys; sys.path.insert(0, '$ROOT/scripts'); from pr36_browser_full_flow import seed_local_ai_fixture; seed_local_ai_fixture()"

"$PYTHON_BIN" "$WITH_SERVER" \
  --server "cd $ROOT && env ASHARE_DATA_ROOT=$ASHARE_DATA_ROOT LANGCHAIN_PROVIDER=$LANGCHAIN_PROVIDER OPENAI_CODEX_BASE_URL=$OPENAI_CODEX_BASE_URL PYTHONPATH=$ROOT/agent $PYTHON_BIN -c 'import cli, sys; raise SystemExit(cli.main(sys.argv[1:]))' serve --host 127.0.0.1 --port $BACKEND_PORT" \
  --port "$BACKEND_PORT" \
  --server "cd $ROOT/frontend && env VITE_API_URL=http://127.0.0.1:$BACKEND_PORT npm run dev -- --host 127.0.0.1 --port $FRONTEND_PORT" \
  --port "$FRONTEND_PORT" \
  --timeout 90 \
  -- "$PYTHON_BIN" "$ROOT/scripts/pr37_browser_radar_pages.py"

step "Check radar route wiring, UI coverage, and guardrails"
node - "$ROOT" <<'NODE'
const fs = require("fs");
const path = require("path");

const root = process.argv[2];
const read = (file) => fs.readFileSync(path.join(root, file), "utf8");

const router = read("frontend/src/router.tsx");
const eventPage = read("frontend/src/pages/EventRadar.tsx");
const sectorPage = read("frontend/src/pages/SectorRadar.tsx");
const homePage = read("frontend/src/pages/Home.tsx");
const api = read("frontend/src/lib/api.ts");
const eventTest = read("frontend/src/pages/__tests__/EventRadar.test.tsx");
const sectorTest = read("frontend/src/pages/__tests__/SectorRadar.test.tsx");
const browserQa = read("scripts/pr37_browser_radar_pages.py");
const fallback = read("frontend/src/pages/AsharePlaceholder.tsx");

const eventRouteStart = router.indexOf("const EventRadar");
const sectorRouteStart = router.indexOf("const SectorRadar");
const eventRouteBlock = eventRouteStart >= 0 && sectorRouteStart > eventRouteStart
  ? router.slice(eventRouteStart, sectorRouteStart)
  : "";
const routeTailStart = router.indexOf("const EventReactions");
const sectorRouteBlock = sectorRouteStart >= 0 && routeTailStart > sectorRouteStart
  ? router.slice(sectorRouteStart, routeTailStart)
  : "";

const required = [
  ["router uses real EventRadar page", eventRouteBlock.includes("@/pages/EventRadar")],
  ["router uses real SectorRadar page", sectorRouteBlock.includes("@/pages/SectorRadar")],
  ["event route no longer points to placeholder", !eventRouteBlock.includes("@/pages/AsharePlaceholder")],
  ["sector route no longer points to placeholder", !sectorRouteBlock.includes("@/pages/AsharePlaceholder")],
  ["event radar imports document collection API", eventPage.includes("collectEventDocuments")],
  ["event radar imports extraction API", eventPage.includes("extractEventRadarEvents")],
  ["event radar imports mapping API", eventPage.includes("mapEventRadarEvents")],
  ["sector radar imports scoring API", sectorPage.includes("runSectorScoring")],
  ["sector radar imports score list API", sectorPage.includes("listSectorScores")],
  ["event-radar API methods are typed", api.includes("EventRadarCollectRequest") && api.includes("/api/event-radar/collect/run")],
  ["sector-score API methods are typed", api.includes("SectorScoreRunRequest") && api.includes("/api/event-radar/sector-scores/run")],
  ["event radar Chinese title exists", eventPage.includes("事件雷达")],
  ["sector radar Chinese title exists", sectorPage.includes("板块雷达")],
  ["home no longer says modules are future work", homePage.includes("核心研究链路已接入本地事件抽取")],
  ["event radar test covers import", eventTest.includes("imports a local document")],
  ["event radar test covers extraction and mapping", eventTest.includes("extracts and maps events")],
  ["sector radar test covers scoring", sectorTest.includes("runs sector scoring")],
  ["browser QA covers event radar route", browserQa.includes("/event-radar") && browserQa.includes("导入本地文档")],
  ["browser QA covers sector radar route", browserQa.includes("/sector-radar") && browserQa.includes("生成板块评分")],
  ["fallback copy no longer says waiting PR", !fallback.includes("等待 PR")],
];

const scannedUi = [router, eventPage, sectorPage, homePage, fallback].join("\n");
const forbidden = [
  ["waiting PR copy must not remain in active UI", "等待 PR"],
  ["future-module copy must not remain in active UI", "后续模块接入"],
  ["model API key must not be introduced", "OPENAI_API_KEY"],
  ["external JoinQuant browser launch must not be added", "window.open("],
  ["external JoinQuant URL must not be hardcoded", "joinquant.com"],
  ["live order action must not be added", "placeOrder"],
  ["live runner start must not be added", "startLiveRunner"],
  ["live authorization must not be added", "authorizeLive"],
  ["live trading copy must not be added", "实盘下单"],
];

const missing = required.filter(([, ok]) => !ok).map(([label]) => label);
const violations = forbidden
  .filter(([, token]) => scannedUi.includes(token))
  .map(([label]) => label);

if (missing.length || violations.length) {
  if (missing.length) console.error("missing:", missing);
  if (violations.length) console.error("violations:", violations);
  process.exit(1);
}
NODE

printf "\nPR-37 acceptance passed.\n"

#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHON_BIN="${PYTHON:-$ROOT/.venv/bin/python}"
WITH_SERVER="/Users/colin/.agents/skills/webapp-testing/scripts/with_server.py"
BACKEND_PORT="${VIBE_ADVISOR_BACKEND_PORT:-18998}"
FRONTEND_PORT="${VIBE_ADVISOR_FRONTEND_PORT:-15898}"
QA_ROOT="$(mktemp -d -t vibe-advisor-qa.XXXXXX)"

cleanup() {
  rm -rf "$QA_ROOT"
}
trap cleanup EXIT

step() {
  printf "\n==> %s\n" "$1"
}

fail() {
  printf "advisor acceptance failed: %s\n" "$1" >&2
  exit 1
}

step "Check advisor browser QA prerequisites"
[[ -x "$PYTHON_BIN" ]] || fail "missing Python virtualenv: $PYTHON_BIN"
[[ -f "$WITH_SERVER" ]] || fail "missing webapp-testing server helper: $WITH_SERVER"
[[ -f "$ROOT/frontend/package.json" ]] || fail "missing frontend package.json"

export ASHARE_DATA_ROOT="$QA_ROOT/ashare"
export LANGCHAIN_PROVIDER="openai-codex"
export OPENAI_CODEX_BASE_URL="https://chatgpt.com/backend-api/codex/responses"
export VIBE_ADVISOR_BACKEND_URL="http://127.0.0.1:$BACKEND_PORT"
export VIBE_ADVISOR_FRONTEND_URL="http://127.0.0.1:$FRONTEND_PORT"
export VIBE_ADVISOR_AS_OF_DATE="2026-06-21"

step "Run advisor action-display browser flow"
"$PYTHON_BIN" "$WITH_SERVER" \
  --server "cd $ROOT && env ASHARE_DATA_ROOT=$ASHARE_DATA_ROOT LANGCHAIN_PROVIDER=$LANGCHAIN_PROVIDER OPENAI_CODEX_BASE_URL=$OPENAI_CODEX_BASE_URL PYTHONPATH=$ROOT/agent $PYTHON_BIN -c 'import cli, sys; raise SystemExit(cli.main(sys.argv[1:]))' serve --host 127.0.0.1 --port $BACKEND_PORT" \
  --port "$BACKEND_PORT" \
  --server "cd $ROOT/frontend && env VITE_API_URL=http://127.0.0.1:$BACKEND_PORT npm run dev -- --host 127.0.0.1 --port $FRONTEND_PORT" \
  --port "$FRONTEND_PORT" \
  --timeout 90 \
  -- "$PYTHON_BIN" "$ROOT/scripts/advisor_action_display_browser_flow.py"

step "Check advisor display guardrails"
node - "$ROOT" <<'NODE'
const fs = require("fs");
const path = require("path");

const root = process.argv[2];
const page = fs.readFileSync(path.join(root, "frontend/src/pages/Advisor.tsx"), "utf8");
const browser = fs.readFileSync(path.join(root, "scripts/advisor_action_display_browser_flow.py"), "utf8");

const required = [
  ["browser flow records a buy", browser.includes("/api/advisor/transactions")],
  ["browser flow writes a thesis", browser.includes("/api/advisor/theses")],
  ["browser flow writes a watchlist item", browser.includes("/api/advisor/watchlist")],
  ["browser flow writes an external validation", browser.includes("/api/advisor/external-validations")],
  ["browser flow writes a decision journal", browser.includes("/api/advisor/decision-journal")],
  ["browser flow opens today page", browser.includes("/advisor/today")],
  ["browser flow opens holdings page", browser.includes("/advisor/holdings")],
  ["browser flow opens watchlist page", browser.includes("/advisor/watchlist")],
  ["browser flow opens journal page", browser.includes("/advisor/journal")],
  ["advisor page shows external validations", page.includes("ValidationCard")],
];

const forbiddenEverywhere = [
  ["model API key must not be introduced", "OPENAI_API_KEY"],
  ["live order action must not be added", "placeOrder"],
  ["live runner start must not be added", "startLiveRunner"],
  ["live authorization must not be added", "authorizeLive"],
];
const forbiddenAdvisorPage = [
  ["advisor page must not expose start-backtest copy", "发起回测"],
  ["advisor page must not expose live trading copy", "实盘下单"],
];

const scanned = `${page}\n${browser}`;
const missing = required.filter(([, ok]) => !ok).map(([label]) => label);
const violations = [
  ...forbiddenEverywhere.filter(([, token]) => scanned.includes(token)).map(([label]) => label),
  ...forbiddenAdvisorPage.filter(([, token]) => page.includes(token)).map(([label]) => label),
];

if (missing.length || violations.length) {
  if (missing.length) console.error("missing:", missing);
  if (violations.length) console.error("violations:", violations);
  process.exit(1);
}
NODE

printf "\nadvisor action-display acceptance passed.\n"

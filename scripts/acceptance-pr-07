#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHON_BIN="${PYTHON:-$ROOT/.venv/bin/python}"
TMP_DIR="$(mktemp -d -t vibe-pr07-event-map.XXXXXX)"

cleanup() {
  rm -rf "$TMP_DIR"
}
trap cleanup EXIT

step() {
  printf "\n==> %s\n" "$1"
}

fail() {
  printf "PR-07 acceptance failed: %s\n" "$1" >&2
  exit 1
}

step "Run PR-07 event mapping tests"
ASHARE_DATA_ROOT="$TMP_DIR/runtime" PYTHONPATH="$ROOT/agent${PYTHONPATH:+:$PYTHONPATH}" "$PYTHON_BIN" -m pytest \
  "$ROOT/agent/tests/test_event_mapping.py" "$ROOT/agent/tests/test_ashare_data_store.py" -q

step "Check event mapping API routes are mounted"
ASHARE_DATA_ROOT="$TMP_DIR/runtime" PYTHONPATH="$ROOT/agent${PYTHONPATH:+:$PYTHONPATH}" "$PYTHON_BIN" - <<'PY'
from __future__ import annotations

import api_server

paths = {route.path for route in api_server.app.routes}
required = {
    "/api/event-radar/theme-map",
    "/api/event-radar/map/run",
    "/api/event-radar/mappings/sectors",
    "/api/event-radar/mappings/stocks",
}
missing = sorted(required - paths)
if missing:
    raise SystemExit(f"missing event mapping API routes: {missing}")
PY

printf "\nPR-07 acceptance passed.\n"

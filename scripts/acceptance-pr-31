#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

step() {
  printf "\n==> %s\n" "$1"
}

step "Run PR-31 trade-plan UI tests"
npm --prefix "$ROOT/frontend" run test:run -- \
  src/pages/__tests__/TradePlan.test.tsx \
  src/config/__tests__/ashareNavigation.test.ts \
  src/components/layout/__tests__/Layout.test.tsx \
  src/pages/__tests__/Home.test.tsx

step "Check trade-plan UI wiring and guardrails"
node - "$ROOT" <<'NODE'
const fs = require("fs");
const path = require("path");

const root = process.argv[2];
const page = fs.readFileSync(path.join(root, "frontend/src/pages/TradePlan.tsx"), "utf8");
const tests = fs.readFileSync(path.join(root, "frontend/src/pages/__tests__/TradePlan.test.tsx"), "utf8");
const api = fs.readFileSync(path.join(root, "frontend/src/lib/api.ts"), "utf8");
const router = fs.readFileSync(path.join(root, "frontend/src/router.tsx"), "utf8");
const nav = fs.readFileSync(path.join(root, "frontend/src/config/ashareNavigation.ts"), "utf8");

const required = [
  ["trade-plan API is wired", api.includes("/api/portfolio-risk/trade-plan")],
  ["typed trade-plan response exists", api.includes("PortfolioTradePlanResponse")],
  ["typed target position exists", api.includes("PortfolioTargetPosition")],
  ["route uses real page", router.includes("@/pages/TradePlan")],
  ["route is registered", router.includes("/trade-plan")],
  ["sidebar navigation exists", nav.includes("交易计划")],
  ["Chinese page title exists", page.includes("交易计划")],
  ["refresh plan action exists", page.includes("刷新交易计划")],
  ["target position section exists", page.includes("目标持仓")],
  ["strategy source section exists", page.includes("策略来源")],
  ["risk guardrail copy exists", page.includes("草稿审阅 / 不审批不下单")],
  ["trade-plan API test exists", tests.includes("loads a draft trade plan through the API")],
  ["guardrail test exists", tests.includes("does not expose approval, signal generation, or live trading actions")],
];

const forbidden = [
  ["OPENAI_API_KEY must not be used", "OPENAI_API_KEY"],
  ["JoinQuant browser automation must not be added", "window.open("],
  ["JoinQuant external URL must not be hardcoded", "joinquant.com"],
  ["Playwright automation must not be added", "playwright"],
  ["Selenium automation must not be added", "selenium"],
  ["trade-plan UI must not call approval", "approvePlan"],
  ["trade-plan UI must not call approve-plan route", "approve-plan"],
  ["trade-plan UI must not generate draft signals", "generateDraftSignals"],
  ["trade-plan UI must not call generate-signals route", "generate-signals"],
  ["trade-plan UI must not call broker action", "placeOrder"],
  ["trade-plan UI must not call live runner", "startLiveRunner"],
  ["trade-plan UI must not call live authorization", "authorizeLive"],
];

const missing = required.filter(([, ok]) => !ok).map(([label]) => label);
const tradePlanApiStart = api.indexOf("getRiskTradePlan");
const tradePlanApiEnd = api.indexOf("listCandidatePool");
const tradePlanApi = tradePlanApiStart >= 0 && tradePlanApiEnd > tradePlanApiStart
  ? api.slice(tradePlanApiStart, tradePlanApiEnd)
  : "";
const scanned = [page, tradePlanApi].join("\n");
const violations = forbidden
  .filter(([, token]) => scanned.includes(token))
  .map(([label]) => label);

if (missing.length || violations.length) {
  if (missing.length) console.error("missing:", missing);
  if (violations.length) console.error("violations:", violations);
  process.exit(1);
}
NODE

printf "\nPR-31 acceptance passed.\n"

{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Vibe-Trading: Backend",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/vibe-trading serve --port 8899",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": ".",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Uvicorn running on|Application startup complete"
        }
      },
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Vibe-Trading: Frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": ".",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Local:|ready in"
        }
      },
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Vibe-Trading: Build Frontend",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": "$tsc"
    },
    {
      "label": "Vibe-Trading: Check Backend Imports",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python -m compileall -q agent",
      "problemMatcher": []
    },
    {
      "label": "Vibe-Trading: PR Smoke Test",
      "type": "shell",
      "command": "bash scripts/smoke",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Vibe-Trading: PR Gate",
      "dependsOn": [
        "Vibe-Trading: PR Smoke Test"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Vibe-Trading: Run All",
      "dependsOn": [
        "Vibe-Trading: Backend",
        "Vibe-Trading: Frontend"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}

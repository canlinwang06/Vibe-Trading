# Optional defense-in-depth key for the backend API.
# The Nginx deployment binds the backend to 127.0.0.1 and only exposes an
# allowlisted read-only cloud surface. Keep this value private when used.
API_AUTH_KEY=

# Keep the project on Codex/ChatGPT-authenticated orchestration. Do not set
# OPENAI_API_KEY for this cloud display package.
LANGCHAIN_PROVIDER=openai-codex
